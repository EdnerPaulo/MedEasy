# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA faça commit do arquivo ".env".

APP_NAME=MedEasy
ENVIRONMENT=development        # development | test | production
DEBUG=false

# Origens permitidas no CORS, separadas por vírgula (frontend local)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Será usado na etapa de persistência (ainda não utilizado).
# Formato: postgresql+psycopg://USUARIO:SENHA@localhost:5432/medeasy
# Deixe vazio por enquanto.
DATABASE_URL=
