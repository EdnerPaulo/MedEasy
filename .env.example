# Copie este arquivo para "backend/.env" e ajuste os valores.
# NUNCA faça commit do arquivo ".env".

APP_NAME=MedEasy

# development | test | production
ENVIRONMENT=development

DEBUG=false

# Banco de dados. SQLite local por padrão.
# Para PostgreSQL (precisa instalar o driver psycopg):
# postgresql+psycopg://USUARIO:SENHA@localhost:5432/medeasy
DATABASE_URL=sqlite:///./medeasy.db
